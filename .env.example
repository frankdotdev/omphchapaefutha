# Data backend: "seed" (built-in verified seed data, read-only), "supabase" (interim backend), or "api" (NestJS, later)
NEXT_PUBLIC_DATA_BACKEND=seed
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (interim backend). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NestJS API (when hosted)
NEXT_PUBLIC_API_URL=

# Server-only secrets: set these in Supabase Edge Function secrets, NEVER as NEXT_PUBLIC_*
# Optional: enables AI answers in Ask a Padre when the doctrine library has no match
MAGISTERIUM_API_KEY=
# LITURGICAL_PROVIDER_KEY=
